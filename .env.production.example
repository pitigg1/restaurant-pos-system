# =============================================
# SistemaHamacas POS — Variables de Entorno para PRODUCCIÓN
# Copia este archivo como .env en producción y ajusta los valores
# =============================================

# ======================
# SEGURIDAD - CRÍTICO
# ======================
# Genera una clave única: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=GENERA_UNA_CLAVE_SECRETA_UNICA_Y_COMPLEJA_AQUI

# DEBUG - DEBE SER FALSE EN PRODUCCIÓN
DEBUG=False

# ALLOWED_HOSTS - Lista de dominios/IPs permitidos (IMPORTANTE)
# Ejemplo: ALLOWED_HOSTS=tudominio.com,www.tudominio.com,192.168.1.100
ALLOWED_HOSTS=tudominio.com

# ======================
# BASE DE DATOS
# ======================
# Para producción se recomienda PostgreSQL
# DATABASE_URL=postgres://usuario:password@localhost:5432/pos_hamacas

# Si usas MySQL:
# DATABASE_URL=mysql://usuario:password@localhost:3306/pos_hamacas

# Si usas SQLite (no recomendado para producción con múltiples usuarios):
# DATABASE_URL=sqlite:///db.sqlite3

# ======================
# IMPRESORA
# ======================
# Nombre EXACTO de la impresora térmica
RECEIPT_PRINTER_NAME=SAT38TUSE

# ======================
# REDIS - REQUERIDO EN PRODUCCIÓN
# ======================
# Usar Redis en producción para channels
USE_REDIS=1

# Configuración de Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=tu_password_redis_seguro

# ======================
# EMAIL - NOTIFICACIONES DE ERRORES
# ======================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notificaciones@tudominio.com
EMAIL_HOST_PASSWORD=tu_password_de_aplicacion
DEFAULT_FROM_EMAIL=noreply@tudominio.com

# Lista de administradores que reciben notificaciones de errores
# Formato: nombre1@email.com,nombre2@email.com
ADMINS=admin@tudominio.com,gerente@tudominio.com

# ======================
# LOGGING
# ======================
# Nivel de logging en producción: INFO o WARNING
LOG_LEVEL=WARNING

# ======================
# RENDIMIENTO
# ======================
# Número de workers de Daphne (ajustar según CPU)
DAPHNE_WORKERS=4

# ======================
# SEGURIDAD ADICIONAL - ACTIVAR CON HTTPS
# ======================
# Redirigir todo el tráfico HTTP a HTTPS
SECURE_SSL_REDIRECT=True

# Cookies seguras (solo HTTPS)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HTTP Strict Transport Security
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Prevenir clickjacking
X_FRAME_OPTIONS=DENY

# Prevenir MIME type sniffing
SECURE_CONTENT_TYPE_NOSNIFF=True

# XSS Protection
SECURE_BROWSER_XSS_FILTER=True

# ======================
# SESIONES
# ======================
# Duración de la sesión en segundos (default: 2 semanas)
SESSION_COOKIE_AGE=1209600

# Cerrar sesión al cerrar el navegador
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# ======================
# ARCHIVOS ESTÁTICOS Y MEDIA
# ======================
# En producción, servir con nginx/apache
# STATIC_ROOT=/var/www/hamacas/static
# MEDIA_ROOT=/var/www/hamacas/media

# ======================
# BACKUP
# ======================
# Ruta para backups automáticos (opcional)
# BACKUP_DIR=/var/backups/hamacas

# ======================
# MONITOREO (OPCIONAL)
# ======================
# Sentry para tracking de errores
# SENTRY_DSN=https://tu-sentry-dsn@sentry.io/proyecto
