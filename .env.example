# =============================================
# SistemaHamacas POS — Variables de Entorno
# Copia este archivo como .env y ajusta los valores
# =============================================

# ======================
# SEGURIDAD
# ======================
# Genera una clave secreta segura: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-secreta-segura-de-50-caracteres

# DEBUG - IMPORTANTE: Debe ser False en producción
DEBUG=True

# ALLOWED_HOSTS - Lista de hosts/dominios permitidos separados por coma
# Ejemplo desarrollo: ALLOWED_HOSTS=localhost,127.0.0.1
# Ejemplo producción: ALLOWED_HOSTS=midominio.com,www.midominio.com,192.168.1.100
ALLOWED_HOSTS=*

# ======================
# BASE DE DATOS
# ======================
# Por defecto usa SQLite. Para producción, considera PostgreSQL o MySQL
# DATABASE_URL=postgres://usuario:password@localhost:5432/nombre_db
# DATABASE_URL=mysql://usuario:password@localhost:3306/nombre_db

# ======================
# IMPRESORA
# ======================
# Nombre EXACTO como aparece en Windows (Panel de Control > Impresoras)
# Ejemplo: RECEIPT_PRINTER_NAME=SAT38TUSE
RECEIPT_PRINTER_NAME=

# ======================
# REDIS (CHANNELS)
# ======================
# 0 = InMemoryChannelLayer (desarrollo, no persistente)
# 1 = Redis (producción, persistente, permite múltiples workers)
USE_REDIS=0

# Configuración de Redis (solo si USE_REDIS=1)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ======================
# EMAIL (OPCIONAL)
# ======================
# Para notificaciones de errores a administradores
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-email@gmail.com
# EMAIL_HOST_PASSWORD=tu-password-de-aplicacion
# DEFAULT_FROM_EMAIL=noreply@tudominio.com
# ADMINS=admin@tudominio.com

# ======================
# LOGGING
# ======================
# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ======================
# RENDIMIENTO
# ======================
# Número de workers para Daphne (producción)
# DAPHNE_WORKERS=4

# ======================
# SEGURIDAD ADICIONAL (PRODUCCIÓN)
# ======================
# Habilitar solo en producción con HTTPS
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ======================
# CORS (si usas frontend separado)
# ======================
# CORS_ALLOWED_ORIGINS=https://miapp.com,https://www.miapp.com
